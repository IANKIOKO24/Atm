{
  "design_system": {
    "name": "Students List Dashboard",
    "type": "dark_theme_admin_interface",
    "description": "Modern dark-themed administrative dashboard with table-based data display"
  },
  "color_palette": {
    "background": {
      "primary": "#1a1a1a",
      "secondary": "#2a2a2a",
      "tertiary": "#333333"
    },
    "text": {
      "primary": "#ffffff",
      "secondary": "#b0b0b0",
      "muted": "#808080"
    },
    "accent": {
      "blue": "#4f7fff",
      "success": "#22c55e",
      "danger": "#ef4444",
      "warning": "#f59e0b"
    },
    "borders": {
      "subtle": "#404040",
      "focus": "#4f7fff"
    }
  },
  "typography": {
    "font_family": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "sizes": {
      "title": 24,
      "heading": 18,
      "body": 14,
      "small": 12,
      "caption": 10
    },
    "weights": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "layout": {
    "header": {
      "height": 80,
      "padding": {"horizontal": 24, "vertical": 16},
      "background": "#1a1a1a",
      "elements": [
        {
          "type": "title",
          "text": "Students List",
          "position": "left",
          "style": {"size": 24, "weight": "semibold", "color": "#ffffff"}
        },
        {
          "type": "breadcrumb",
          "items": ["Dashboard", "Students", "All Students"],
          "position": "left_below_title",
          "style": {"size": 12, "color": "#808080"}
        },
        {
          "type": "action_buttons",
          "position": "right",
          "buttons": [
            {
              "type": "icon_button",
              "icon": "refresh",
              "variant": "ghost"
            },
            {
              "type": "icon_button", 
              "icon": "print",
              "variant": "ghost"
            },
            {
              "type": "dropdown_button",
              "text": "Export",
              "icon": "download",
              "variant": "ghost"
            },
            {
              "type": "primary_button",
              "text": "Add Student",
              "icon": "plus",
              "variant": "primary"
            }
          ]
        }
      ]
    },
    "toolbar": {
      "height": 60,
      "padding": {"horizontal": 24, "vertical": 12},
      "background": "#2a2a2a",
      "elements": [
        {
          "type": "section_title",
          "text": "Students List",
          "position": "left"
        },
        {
          "type": "date_range",
          "position": "left_center",
          "format": "MM/DD/YYYY - MM/DD/YYYY"
        },
        {
          "type": "filter_button",
          "text": "Filter",
          "icon": "filter",
          "position": "center_left"
        },
        {
          "type": "view_toggle",
          "options": ["list", "grid"],
          "position": "center_right"
        },
        {
          "type": "sort_dropdown",
          "text": "Sort by A-Z",
          "position": "right"
        }
      ]
    },
    "controls": {
      "height": 40,
      "padding": {"horizontal": 24, "vertical": 8},
      "background": "#1a1a1a",
      "elements": [
        {
          "type": "pagination_control",
          "label": "Row Per Page",
          "dropdown": true,
          "position": "left"
        },
        {
          "type": "entries_count",
          "text": "Entries",
          "position": "left_center"
        },
        {
          "type": "search_box",
          "placeholder": "Search",
          "position": "right",
          "width": 200
        }
      ]
    },
    "table": {
      "background": "#1a1a1a",
      "border_radius": 8,
      "headers": {
        "height": 48,
        "background": "#2a2a2a",
        "text_color": "#ffffff",
        "font_weight": "medium"
      },
      "rows": {
        "height": 56,
        "alternating_colors": false,
        "hover_color": "#333333",
        "selected_color": "#4f7fff20"
      },
      "borders": {
        "color": "#404040",
        "width": 1
      }
    }
  },
  "components": {
    "buttons": {
      "primary": {
        "background": "#4f7fff",
        "text_color": "#ffffff",
        "border_radius": 6,
        "padding": {"horizontal": 16, "vertical": 8},
        "hover_effect": "brightness_increase"
      },
      "ghost": {
        "background": "transparent",
        "text_color": "#b0b0b0",
        "border": "1px solid #404040",
        "border_radius": 6,
        "padding": {"horizontal": 12, "vertical": 8},
        "hover_effect": "background_lighten"
      },
      "icon_only": {
        "size": 32,
        "border_radius": 6,
        "background": "transparent",
        "hover_effect": "background_lighten"
      }
    },
    "table_elements": {
      "checkbox": {
        "size": 16,
        "border_radius": 3,
        "border_color": "#404040",
        "checked_color": "#4f7fff"
      },
      "avatar": {
        "size": 32,
        "border_radius": "50%",
        "border": "2px solid #404040"
      },
      "status_badge": {
        "height": 20,
        "border_radius": 10,
        "padding": {"horizontal": 8, "vertical": 2},
        "variants": {
          "active": {"background": "#22c55e", "text": "#ffffff"},
          "inactive": {"background": "#ef4444", "text": "#ffffff"}
        }
      },
      "link_text": {
        "color": "#4f7fff",
        "hover_effect": "underline"
      }
    },
    "form_elements": {
      "dropdown": {
        "height": 36,
        "background": "#2a2a2a",
        "border": "1px solid #404040",
        "border_radius": 6,
        "padding": {"horizontal": 12, "vertical": 8}
      },
      "search_input": {
        "height": 36,
        "background": "#2a2a2a",
        "border": "1px solid #404040",
        "border_radius": 6,
        "padding": {"horizontal": 12, "vertical": 8},
        "placeholder_color": "#808080"
      }
    }
  },
  "table_structure": {
    "columns": [
      {
        "key": "selection",
        "type": "checkbox",
        "width": 48,
        "sortable": false
      },
      {
        "key": "admission_no",
        "label": "Admission No",
        "type": "link",
        "width": 120,
        "sortable": true
      },
      {
        "key": "roll_no", 
        "label": "Roll No",
        "type": "text",
        "width": 100,
        "sortable": true
      },
      {
        "key": "name",
        "label": "Name",
        "type": "avatar_with_text",
        "width": 200,
        "sortable": true
      },
      {
        "key": "class",
        "label": "Class",
        "type": "text",
        "width": 80,
        "sortable": true
      },
      {
        "key": "section",
        "label": "Section", 
        "type": "text",
        "width": 80,
        "sortable": true
      },
      {
        "key": "gender",
        "label": "Gender",
        "type": "text",
        "width": 100,
        "sortable": true
      },
      {
        "key": "status",
        "label": "Status",
        "type": "badge",
        "width": 100,
        "sortable": true
      }
    ]
  },
  "spacing": {
    "unit": 4,
    "scales": {
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 24,
      "2xl": 32
    }
  },
  "animations": {
    "hover_transitions": {
      "duration": "0.2s",
      "easing": "ease-in-out"
    },
    "focus_transitions": {
      "duration": "0.15s",
      "easing": "ease-out"
    }
  },
  "customtkinter_implementation_guide": {
    "setup": {
      "import": "import customtkinter as ctk",
      "appearance_mode": "ctk.set_appearance_mode('dark')",
      "color_theme": "ctk.set_default_color_theme('blue')",
      "window_setup": "ctk.CTk()"
    },
    "recommended_widgets": {
      "main_window": "ctk.CTk()",
      "frames": "ctk.CTkFrame()",
      "buttons": "ctk.CTkButton()",
      "labels": "ctk.CTkLabel()",
      "entries": "ctk.CTkEntry()",
      "dropdowns": "ctk.CTkComboBox()",
      "checkboxes": "ctk.CTkCheckBox()",
      "scrollable_frame": "ctk.CTkScrollableFrame()"
    },
    "table_implementation": {
      "approach": "Use CTkScrollableFrame with grid of CTkFrame rows",
      "header_row": "CTkFrame with CTkLabels for column headers",
      "data_rows": "CTkFrame for each row with CTkLabels, CTkButtons, etc.",
      "selection": "CTkCheckBox in first column",
      "hover_effect": "Configure hover_color property"
    },
    "styling_configuration": {
      "custom_colors": {
        "fg_color": "#2a2a2a",
        "hover_color": "#333333",
        "border_color": "#404040",
        "button_color": "#4f7fff",
        "button_hover_color": "#6b8fff",
        "text_color": "#ffffff",
        "text_color_disabled": "#808080"
      },
      "fonts": {
        "title_font": "ctk.CTkFont(family='Inter', size=24, weight='bold')",
        "heading_font": "ctk.CTkFont(family='Inter', size=18, weight='normal')",
        "body_font": "ctk.CTkFont(family='Inter', size=14, weight='normal')",
        "small_font": "ctk.CTkFont(family='Inter', size=12, weight='normal')"
      }
    },
    "component_examples": {
      "primary_button": {
        "widget": "ctk.CTkButton",
        "properties": {
          "fg_color": "#4f7fff",
          "hover_color": "#6b8fff",
          "border_width": 0,
          "corner_radius": 6,
          "font": "ctk.CTkFont(size=14, weight='normal')",
          "text_color": "#ffffff"
        }
      },
      "ghost_button": {
        "widget": "ctk.CTkButton",
        "properties": {
          "fg_color": "transparent",
          "hover_color": "#333333",
          "border_width": 1,
          "border_color": "#404040",
          "corner_radius": 6,
          "font": "ctk.CTkFont(size=14, weight='normal')",
          "text_color": "#b0b0b0"
        }
      },
      "search_entry": {
        "widget": "ctk.CTkEntry",
        "properties": {
          "fg_color": "#2a2a2a",
          "border_color": "#404040",
          "corner_radius": 6,
          "font": "ctk.CTkFont(size=14, weight='normal')",
          "text_color": "#ffffff",
          "placeholder_text_color": "#808080"
        }
      },
      "dropdown": {
        "widget": "ctk.CTkComboBox",
        "properties": {
          "fg_color": "#2a2a2a",
          "border_color": "#404040",
          "button_color": "#404040",
          "button_hover_color": "#555555",
          "corner_radius": 6,
          "font": "ctk.CTkFont(size=14, weight='normal')",
          "text_color": "#ffffff"
        }
      },
      "data_frame": {
        "widget": "ctk.CTkFrame",
        "properties": {
          "fg_color": "#1a1a1a",
          "border_width": 1,
          "border_color": "#404040",
          "corner_radius": 8
        }
      },
      "table_header": {
        "widget": "ctk.CTkFrame",
        "properties": {
          "fg_color": "#2a2a2a",
          "corner_radius": 0,
          "height": 48
        }
      },
      "table_row": {
        "widget": "ctk.CTkFrame",
        "properties": {
          "fg_color": "#1a1a1a",
          "hover_color": "#333333",
          "corner_radius": 0,
          "height": 56,
          "border_width": 0
        }
      },
      "status_badge": {
        "widget": "ctk.CTkLabel",
        "properties": {
          "fg_color": "#22c55e",
          "corner_radius": 10,
          "font": "ctk.CTkFont(size=12, weight='normal')",
          "text_color": "#ffffff",
          "width": 60,
          "height": 20"
        }
      },
      "avatar_frame": {
        "widget": "ctk.CTkFrame",
        "properties": {
          "fg_color": "transparent",
          "width": 32,
          "height": 32,
          "corner_radius": 16
        }
      }
    },
    "layout_strategy": {
      "geometry_manager": "grid",
      "main_container": "CTkFrame with grid layout",
      "responsive_columns": "Configure column weights with grid_columnconfigure",
      "sticky_headers": "Use separate frame for table headers",
      "scrollable_content": "CTkScrollableFrame for table body"
    },
    "implementation_notes": [
      "CustomTkinter automatically handles dark theme styling",
      "Built-in hover effects for buttons and frames",
      "Corner radius property provides rounded corners",
      "Use grid geometry manager for precise control",
      "CTkScrollableFrame handles overflow content automatically",
      "Configure column weights for responsive design",
      "Use transparent fg_color for ghost/invisible containers",
      "Bind events to frames for row selection/hover effects"
    ],
    "sample_color_scheme": {
      "background_primary": "#1a1a1a",
      "background_secondary": "#2a2a2a", 
      "background_tertiary": "#333333",
      "border_color": "#404040",
      "accent_blue": "#4f7fff",
      "accent_blue_hover": "#6b8fff",
      "success_green": "#22c55e",
      "danger_red": "#ef4444",
      "text_primary": "#ffffff",
      "text_secondary": "#b0b0b0",
      "text_muted": "#808080"
    }
  }
}