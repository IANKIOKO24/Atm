{
  "design_system": {
    "name": "Students List Dashboard",
    "type": "dark_theme_admin_interface",
    "description": "Modern dark-themed administrative dashboard with table-based data display"
  },
  "color_palette": {
    "background": {
      "primary": "#0d1117",
      "secondary": "#161b22",
      "tertiary": "#21262d"
    },
    "text": {
      "primary": "#f0f6fc",
      "secondary": "#7d8590",
      "muted": "#656d76"
    },
    "accent": {
      "blue": "#238636",
      "success": "#238636",
      "danger": "#da3633",
      "warning": "#fb8500"
    },
    "borders": {
      "subtle": "#30363d",
      "focus": "#238636"
    }
  },
  "typography": {
    "font_family": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "sizes": {
      "title": 24,
      "heading": 18,
      "body": 14,
      "small": 12,
      "caption": 10
    },
    "weights": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "layout": {
    "header": {
      "height": 80,
      "padding": {"horizontal": 24, "vertical": 16},
      "background": "#0d1117",
      "elements": [
        {
          "type": "title",
          "text": "Students List",
          "position": "left",
          "style": {"size": 24, "weight": "semibold", "color": "#f0f6fc"}
        },
        {
          "type": "breadcrumb",
          "items": ["Dashboard", "Students", "All Students"],
          "position": "left_below_title",
          "style": {"size": 12, "color": "#7d8590"}
        },
        {
          "type": "action_buttons",
          "position": "right",
          "buttons": [
            {
              "type": "icon_button",
              "icon": "refresh",
              "variant": "ghost"
            },
            {
              "type": "icon_button", 
              "icon": "print",
              "variant": "ghost"
            },
            {
              "type": "dropdown_button",
              "text": "Export",
              "icon": "download",
              "variant": "ghost"
            },
            {
              "type": "primary_button",
              "text": "Add Student",
              "icon": "plus",
              "variant": "primary"
            }
          ]
        }
      ]
    },
    "toolbar": {
      "height": 60,
      "padding": {"horizontal": 24, "vertical": 12},
      "background": "#161b22",
      "elements": [
        {
          "type": "section_title",
          "text": "Students List",
          "position": "left"
        },
        {
          "type": "date_range",
          "position": "left_center",
          "format": "MM/DD/YYYY - MM/DD/YYYY"
        },
        {
          "type": "filter_button",
          "text": "Filter",
          "icon": "filter",
          "position": "center_left"
        },
        {
          "type": "view_toggle",
          "options": ["list", "grid"],
          "position": "center_right"
        },
        {
          "type": "sort_dropdown",
          "text": "Sort by A-Z",
          "position": "right"
        }
      ]
    },
    "controls": {
      "height": 40,
      "padding": {"horizontal": 24, "vertical": 8},
      "background": "#0d1117",
      "elements": [
        {
          "type": "pagination_control",
          "label": "Row Per Page",
          "dropdown": true,
          "position": "left"
        },
        {
          "type": "entries_count",
          "text": "Entries",
          "position": "left_center"
        },
        {
          "type": "search_box",
          "placeholder": "Search",
          "position": "right",
          "width": 200
        }
      ]
    },
    "table": {
      "background": "#0d1117",
      "border_radius": 8,
      "headers": {
        "height": 48,
        "background": "#161b22",
        "text_color": "#f0f6fc",
        "font_weight": "medium"
      },
      "rows": {
        "height": 56,
        "alternating_colors": false,
        "hover_color": "#21262d",
        "selected_color": "#23863620"
      },
      "borders": {
        "color": "#30363d",
        "width": 1
      }
    }
  },
  "components": {
    "buttons": {
      "primary": {
        "background": "#238636",
        "text_color": "#ffffff",
        "border_radius": 6,
        "padding": {"horizontal": 16, "vertical": 8},
        "hover_effect": "brightness_increase"
      },
      "ghost": {
        "background": "transparent",
        "text_color": "#7d8590",
        "border": "1px solid #30363d",
        "border_radius": 6,
        "padding": {"horizontal": 12, "vertical": 8},
        "hover_effect": "background_lighten"
      },
      "icon_only": {
        "size": 32,
        "border_radius": 6,
        "background": "transparent",
        "hover_effect": "background_lighten"
      }
    },
    "table_elements": {
      "checkbox": {
        "size": 16,
        "border_radius": 3,
        "border_color": "#30363d",
        "checked_color": "#238636"
      },
      "avatar": {
        "size": 32,
        "border_radius": "50%",
        "border": "2px solid #30363d"
      },
      "status_badge": {
        "height": 20,
        "border_radius": 10,
        "padding": {"horizontal": 8, "vertical": 2},
        "variants": {
          "active": {"background": "#238636", "text": "#ffffff"},
          "inactive": {"background": "#da3633", "text": "#ffffff"}
        }
      },
      "link_text": {
        "color": "#238636",
        "hover_effect": "underline"
      }
    },
    "form_elements": {
      "dropdown": {
        "height": 36,
        "background": "#161b22",
        "border": "1px solid #30363d",
        "border_radius": 6,
        "padding": {"horizontal": 12, "vertical": 8}
      },
      "search_input": {
        "height": 36,
        "background": "#161b22",
        "border": "1px solid #30363d",
        "border_radius": 6,
        "padding": {"horizontal": 12, "vertical": 8},
        "placeholder_color": "#656d76"
      }
    }
  },
  "table_structure": {
    "columns": [
      {
        "key": "selection",
        "type": "checkbox",
        "width": 48,
        "sortable": false
      },
      {
        "key": "admission_no",
        "label": "Admission No",
        "type": "link",
        "width": 120,
        "sortable": true
      },
      {
        "key": "roll_no", 
        "label": "Roll No",
        "type": "text",
        "width": 100,
        "sortable": true
      },
      {
        "key": "name",
        "label": "Name",
        "type": "avatar_with_text",
        "width": 200,
        "sortable": true
      },
      {
        "key": "class",
        "label": "Class",
        "type": "text",
        "width": 80,
        "sortable": true
      },
      {
        "key": "section",
        "label": "Section", 
        "type": "text",
        "width": 80,
        "sortable": true
      },
      {
        "key": "gender",
        "label": "Gender",
        "type": "text",
        "width": 100,
        "sortable": true
      },
      {
        "key": "status",
        "label": "Status",
        "type": "badge",
        "width": 100,
        "sortable": true
      }
    ]
  },
  "spacing": {
    "unit": 4,
    "scales": {
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 24,
      "2xl": 32
    }
  },
  "animations": {
    "hover_transitions": {
      "duration": "0.2s",
      "easing": "ease-in-out"
    },
    "focus_transitions": {
      "duration": "0.15s",
      "easing": "ease-out"
    }
  },
  "customtkinter_implementation_guide": {
    "setup": {
      "import": "import customtkinter as ctk",
      "appearance_mode": "ctk.set_appearance_mode('dark')",
      "color_theme": "ctk.set_default_color_theme('blue')",
      "window_setup": "ctk.CTk()"
    },
    "recommended_widgets": {
      "main_window": "ctk.CTk()",
      "frames": "ctk.CTkFrame()",
      "buttons": "ctk.CTkButton()",
      "labels": "ctk.CTkLabel()",
      "entries": "ctk.CTkEntry()",
      "dropdowns": "ctk.CTkComboBox()",
      "checkboxes": "ctk.CTkCheckBox()",
      "scrollable_frame": "ctk.CTkScrollableFrame()"
    },
    "table_implementation": {
      "approach": "Use CTkScrollableFrame with grid of CTkFrame rows",
      "header_row": "CTkFrame with CTkLabels for column headers",
      "data_rows": "CTkFrame for each row with CTkLabels, CTkButtons, etc.",
      "selection": "CTkCheckBox in first column",
      "hover_effect": "Configure hover_color property"
    },
         "styling_configuration": {
       "custom_colors": {
         "fg_color": "#161b22",
         "hover_color": "#21262d",
         "border_color": "#30363d",
         "button_color": "#238636",
         "button_hover_color": "#2ea043",
         "text_color": "#f0f6fc",
         "text_color_disabled": "#656d76"
       },
      "fonts": {
        "title_font": "ctk.CTkFont(family='Inter', size=24, weight='bold')",
        "heading_font": "ctk.CTkFont(family='Inter', size=18, weight='normal')",
        "body_font": "ctk.CTkFont(family='Inter', size=14, weight='normal')",
        "small_font": "ctk.CTkFont(family='Inter', size=12, weight='normal')"
      }
    },
    "component_examples": {
             "primary_button": {
         "widget": "ctk.CTkButton",
         "properties": {
           "fg_color": "#238636",
           "hover_color": "#2ea043",
           "border_width": 0,
           "corner_radius": 6,
           "font": "ctk.CTkFont(size=14, weight='normal')",
           "text_color": "#ffffff"
         }
       },
       "ghost_button": {
         "widget": "ctk.CTkButton",
         "properties": {
           "fg_color": "transparent",
           "hover_color": "#21262d",
           "border_width": 1,
           "border_color": "#30363d",
           "corner_radius": 6,
           "font": "ctk.CTkFont(size=14, weight='normal')",
           "text_color": "#7d8590"
         }
       },
       "search_entry": {
         "widget": "ctk.CTkEntry",
         "properties": {
           "fg_color": "#161b22",
           "border_color": "#30363d",
           "corner_radius": 6,
           "font": "ctk.CTkFont(size=14, weight='normal')",
           "text_color": "#f0f6fc",
           "placeholder_text_color": "#656d76"
         }
       },
       "dropdown": {
         "widget": "ctk.CTkComboBox",
         "properties": {
           "fg_color": "#161b22",
           "border_color": "#30363d",
           "button_color": "#30363d",
           "button_hover_color": "#21262d",
           "corner_radius": 6,
           "font": "ctk.CTkFont(size=14, weight='normal')",
           "text_color": "#f0f6fc"
         }
       },
       "data_frame": {
         "widget": "ctk.CTkFrame",
         "properties": {
           "fg_color": "#0d1117",
           "border_width": 1,
           "border_color": "#30363d",
           "corner_radius": 8
         }
       },
       "table_header": {
         "widget": "ctk.CTkFrame",
         "properties": {
           "fg_color": "#161b22",
           "corner_radius": 0,
           "height": 48
         }
       },
       "table_row": {
         "widget": "ctk.CTkFrame",
         "properties": {
           "fg_color": "#0d1117",
           "hover_color": "#21262d",
           "corner_radius": 0,
           "height": 56,
           "border_width": 0
         }
       },
       "status_badge": {
         "widget": "ctk.CTkLabel",
         "properties": {
           "fg_color": "#238636",
           "corner_radius": 10,
           "font": "ctk.CTkFont(size=12, weight='normal')",
           "text_color": "#ffffff",
           "width": 60,
           "height": 20
         }
       },
      "avatar_frame": {
        "widget": "ctk.CTkFrame",
        "properties": {
          "fg_color": "transparent",
          "width": 32,
          "height": 32,
          "corner_radius": 16
        }
      }
    },
    "layout_strategy": {
      "geometry_manager": "grid",
      "main_container": "CTkFrame with grid layout",
      "responsive_columns": "Configure column weights with grid_columnconfigure",
      "sticky_headers": "Use separate frame for table headers",
      "scrollable_content": "CTkScrollableFrame for table body"
    },
    "implementation_notes": [
      "CustomTkinter automatically handles dark theme styling",
      "Built-in hover effects for buttons and frames",
      "Corner radius property provides rounded corners",
      "Use grid geometry manager for precise control",
      "CTkScrollableFrame handles overflow content automatically",
      "Configure column weights for responsive design",
      "Use transparent fg_color for ghost/invisible containers",
      "Bind events to frames for row selection/hover effects"
    ],
         "sample_color_scheme": {
       "background_primary": "#0d1117",
       "background_secondary": "#161b22", 
       "background_tertiary": "#21262d",
       "border_color": "#30363d",
       "accent_green": "#238636",
       "accent_green_hover": "#2ea043",
       "success_green": "#238636",
       "danger_red": "#da3633",
       "text_primary": "#f0f6fc",
       "text_secondary": "#7d8590",
       "text_muted": "#656d76"
     }
  }
}